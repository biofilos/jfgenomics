<Layouts.app flash={@flash}>
  <div class="max-w-6xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Publications</h1>
      <p class="mt-2 text-base-content/70">
        Peer-reviewed work from my time in academia.
      </p>
    </header>

    <div id="publications" class="grid grid-cols-1 gap-4">
      <.publication_card :for={pub <- @publications} pub={pub} />
    </div>
  </div>
</Layouts.app>
