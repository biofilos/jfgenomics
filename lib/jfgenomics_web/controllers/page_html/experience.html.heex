<Layouts.app flash={@flash}>
  <div class="max-w-4xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Experience</h1>
      <p class="mt-2 text-base-content/70">
        Where genomics meets the real world.
      </p>
    </header>

    <ol class="ms-6 flex flex-col gap-10 border-s-2 border-primary/25">
      <.timeline_item
        :for={job <- @experience}
        title={"#{job.title} · #{job.place}"}
        badges={[job.country, job.dates]}
      >
        <ul class="list-disc space-y-1 ps-5">
          <li :for={item <- job.description}>{item}</li>
        </ul>
      </.timeline_item>
    </ol>
  </div>
</Layouts.app>
