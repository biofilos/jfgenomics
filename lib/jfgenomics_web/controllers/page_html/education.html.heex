<Layouts.app flash={@flash}>
  <div class="max-w-6xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Education</h1>
      <p class="mt-2 text-base-content/70">
        My formal training, and the publications that came out of each degree.
      </p>
    </header>

    <div id="education" class="grid grid-cols-1 gap-4">
      <.education_card
        :for={entry <- @education}
        title={entry.title}
        school={entry.school}
        area={entry.area}
        publication={entry.publication}
        pub_link={entry.pub_link}
      />
    </div>

    <section class="pt-12">
      <h2 class="text-3xl font-bold tracking-tight">Awards and Grants</h2>
      <ul
        id="awards"
        class="mt-6 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100 shadow-sm"
      >
        <.icon_list_item
          :for={award <- @awards}
          icon="hero-trophy"
          title={award.name}
          subtitle={award.institution}
          badges={[award.time]}
        />
      </ul>
    </section>

    <section class="pt-12">
      <h2 class="text-3xl font-bold tracking-tight">Courses and Workshops</h2>
      <ul
        id="courses"
        class="mt-6 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100 shadow-sm"
      >
        <.icon_list_item
          :for={course <- @courses}
          icon="hero-book-open"
          title={course.name}
          subtitle={course.institution}
          badges={[course.place, "#{course.duration}, #{course.year}"]}
        />
      </ul>
    </section>
  </div>
</Layouts.app>
